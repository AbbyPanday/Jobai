# =======================================================
# Job Intelligence Engine — Environment Configuration
# =======================================================

# ── Gemini / Google AI ───────────────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Client ID (optional — enables "Sign in with Google" popup)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ── Serper API (REQUIRED for live job search) ────────────────────────────────
# Free tier: 100 queries/month → https://serper.dev
# Powers LinkedIn, Naukri, Greenhouse, Lever, and Workday job discovery
SERPER_API_KEY=

# Max results fetched per source per search (default 20)
SERPER_MAX_RESULTS=20

# ── LinkedOut Networking (optional A2A job discovery) ────────────────────────
# Register at: https://linkedout.so
# Used to post job intent and find agent-to-agent matches from hiring managers
LINKEDOUT_API_KEY=
LINKEDOUT_AGENT_HANDLE=

# ── GCP Settings (optional — for Cloud Firestore/Storage) ───────────────────
GCP_PROJECT_ID=local-dev-project
GCP_REGION=asia-south1
GCS_BUCKET_NAME=job-agent-artifacts
